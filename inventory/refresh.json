ss/", "image_url": "https://cdn.arstechnica.net/wp-content/uploads/2026/09/claudebyanthropic-1024x648.jpg", "video_url": null, "thumbnail_url": null, "duration_secs": 0, "downloadable": false, "category": "Tech", "topic": "tech", "content_type": "text", "lang": "en", "tags": ["Ars Technica", "Tech", "en", "tech", "text", "科技"], "excerpt": "Anthropic has granted external evaluators “employee-like access” to assess the risks of its models, following through on a commitment to increase safeguards", "published_at": "2026-10-18T16:25:19Z", "curated_at": "2026-10-19T10:12:33Z", "body": "bodies/feed-56b1c8aea759.json", "engagement": 120, "opens": 0, "upvotes": 0}, {"id": "feed-7e9aebe6b9cc", "title": "实测 Lovart 2.0 ，设计 AI 进入个人助理时代", "source": "爱范儿", "author": "樊 尔", "url": "https://www.ifanr.com/1684840?utm_source=rss&utm_medium=rss&utm_campaign=", "image_url": "https://s3.ifanr.com/wp-content/uploads/2026/10/titu.jpg", "video_url": null, "thumbnail_url": null, "duration_secs": 0, "downloadable": false, "category": "Tech", "topic": "zh_tech", "content_type": "text", "lang": "zh", "tags": ["Tech", "text", "zh", "zh_tech", "爱范儿", "科技"], "excerpt": "\nAI 生图和改图已经很强了，却依然救不了双 11 期间疯狂加班的设计师。\n\n\nAI 出图确实快，但曾经在广告公司做设计主管的我深知，出图之外的设计灵感、沟通协作和反复改稿，才是耗时的大头：\n\n\n团队得先理解客户的品牌调性，才能沿着同一个方向做下去。换成", "published_at": "2026-10-19T02:53:15Z", "curated_at": "2026-10-19T10:12:33Z", "body": "bodies/feed-7e9aebe6b9cc.json", "engagement": 140, "opens": 0, "upvotes": 0}, {"id": "feed-8246dcf87590", "title": "Major fire at Canada military base leaves four dead, dozens injured", "source": "BBC", "author": "", "url": "https://www.bbc.co.uk/news/articles/cxj0ly1m3q81o?at_medium=RSS&at_campaign=rss", "image_url": "https://ichef.bbci.co.uk/ace/standard/240/cpsprodpb/e891/live/86ce21f0-cb34-11f1-9a39-31b474234113.jpg", "video_url": null, "thumbnail_url": null, "duration_secs": 0, "downloadable": false, "category": "News", "topic": "news", "content_type": "text", "lang": "en", "tags": ["BBC", "News", "en", "news", "text", "投资"], "excerpt": "Four members of the Canadian military have died and dozens were injured at a base in the province of Alberta after a fire broke out in a grassy training area", "published_at": "2026-10-18T23:06:09Z", "curated_at": "2026-10-19T10:12:33Z", "body": "bodies/feed-8246dcf87590.json", "engagement": 110, "opens": 0, "upvotes": 0}, {"id": "feed-8c58f6ce25f2", "title": "A股早盘低开低走，双创指数均跌超2%，AI硬件、芯片半导体再度调整，白酒、银行逆势拉升", "source": "华尔街见闻", "author": "", "url": "https://wallstreetcn.com/articles/3783895", "image_url": "https://wpimg-wscn.awtmt.com/9e1fc725-ac6b-449a-b1cf-d7f8c6e6f2c0.jpeg", "video_url": null, "thumbnail_url": null, "duration_secs": 0, "downloadable": false, "category": "Finance", "topic": "zh_money", "content_type": "text", "lang": "zh", "tags": ["Finance", "text", "zh", "zh_money", "华尔街见闻", "科技"], "excerpt": "存储芯片多数下跌，长鑫科技大跌超7%，早盘一度跌近9%、股价创上市首日以来新低，拖累其市值回落——这也是工商银行得以重返A股市值第一的另一半原因。长鑫科技三季度净利润环比增幅大幅放缓至约1%—3.9%（一季度、二季度环比增速分别高达246.09%、113.4%）。\n\n10月19日，A股三大股指集体低开，沪指在银行、白酒", "published_at": "2026-10-19T02:35:55Z", "curated_at": "2026-10-19T10:12:33Z", "body": "bodies/feed-8c58f6ce25f2.json", "engagement": 190, "opens": 0, "upvotes": 0}, {"id": "feed-96ef12f67449", "title": "8点1氪丨iPhone Duo溢价暴跌至3000元；多家A股科技龙头公司宣布计划回购；王自如称想与罗永浩和解", "source": "36氪", "author": "", "url": "https://36kr.com/p/4032044521558403?f=rss", "image_url": null, "video_url": null, "thumbnail_url": null, "duration_secs": 0, "downloadable": false, "category": "Tech", "topic": "zh_tech", "content_type": "text", "lang": "zh", "tags": ["36氪", "Tech", "text", "zh", "zh_tech", "科技"], "excerpt": "今日热点导览\n\n\nDeepSeek新模型Token消耗降超五成\n\n\n燃油车在中国市场销售占比首次跌破三分之一\n\n\n特斯拉将发布财报，SpaceX将公布上市后的第二份财报\n\n\nSwisse“抗糖丸”被检出铅超标，官方客服：相关批次未进入中国销售\n\n\n港股结算机制生变：“T+2”将改为“T+1”，2028年下半年完成\n\n\n", "published_at": "2026-10-19T10:10:58Z", "curated_at": "2026-10-19T10:12:33Z", "body": "bodies/feed-96ef12f67449.json", "engagement": 190, "opens": 0, "upvotes": 0}, {"id": "feed-9df3b2b600ae", "title": "客户为什么愿意为端侧 AI 买单？五位一线操盘手讲透了", "source": "极客公园", "author": "", "url": "http://www.geekpark.net/news/372578", "image_url": "https://imgslim.geekpark.net/uploads/image/file/f9/64/f9645516cac39324f08688f4bd2f5299.jpg", "video_url": null, "thumbnail_url": null, "duration_secs": 0, "downloadable": false, "category": "Tech", "topic": "zh_tech", "content_type": "text", "lang": "zh", "tags": ["Tech", "text", "zh", "zh_tech", "极客公园", "科技"], "excerpt": "过去几年，AI 行业热衷于比参数、拼算力、讲融资。但模型一旦离开展台，客户的问题立刻具体起来：数据会不会泄露？设备能不能 24 小时运行？响应够不够快？噪声大不大？\n\n\n这些问题，正把端侧 AI 推到产业舞台中央。\n\n\n10 月 14 日，后摩智能在北京开了一场生态合作伙伴大会。期间，极客公园创始人 & CEO", "published_at": "2026-10-19T10:10:03Z", "curated_at": "2026-10-19T10:12:33Z", "body": "bodies/feed-9df3b2b600ae.json", "engagement": 170, "opens": 0, "upvotes": 0}], "status": {"exhausted": false, "next_crawl_at": "2026-10-20T06:10:00-04:00", "inventory_count": 5688}}